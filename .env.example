# OumnoSup configuration.
#
# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# SECRET_KEY and ADMIN_TOKEN below are placeholders. Settings refuses to start
# with ENVIRONMENT=production while either still holds its example value, so a
# deployment cannot silently run on them.

# --- Environment -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Must use the asyncpg driver; a synchronous URL is rejected at startup.
# Inside docker compose the host is `postgres`, not `localhost`.
DATABASE_URL=postgresql+asyncpg://oumnosup:oumnosup@localhost:5432/oumnosup
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# --- Redis -----------------------------------------------------------------
# Optional. Without it the rate limiter falls back to per-process limiting and
# the API response cache is disabled; nothing breaks.
REDIS_URL=redis://localhost:6379/0

# --- Scraping --------------------------------------------------------------
SCRAPE_DELAY_SECONDS=1
SCRAPE_MAX_RETRIES=3
SCRAPE_TIMEOUT=30
# JSON array. Delays applied between successive retries.
SCRAPE_RETRY_BACKOFF=[5,30,120]
# Honour a platform's declared Crawl-delay when it is slower than the default.
# parcoursup.gouv.fr asks for 10s, ten times the project default.
SCRAPE_RESPECT_ROBOTS_CRAWL_DELAY=true
SCRAPE_USER_AGENT=OumnoSupBot/0.1 (+https://oumnosup.com/bot)
# Comma-separated proxy URLs. Leave empty for none.
PROXY_LIST=

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT_PER_MINUTE=100
# JSON array of allowed origins.
API_CORS_ORIGINS=["http://localhost:3000","https://oumnosup.com"]
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100
API_CACHE_TTL_SECONDS=300

# --- Secrets ---------------------------------------------------------------
SECRET_KEY=change-me-in-production
ADMIN_TOKEN=change-me-too
# Optional. Unused by the default rule-based translator.
ANTHROPIC_API_KEY=
